# Скопируйте в .env (git его не отслеживает) и подставьте свои значения.

DJANGO_DEBUG=True
# Обязательно задайте длинную случайную строку, когда DJANGO_DEBUG=False:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Откуда фронтенд ходит в API при разработке (npm run dev). Через запятую.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Адрес фронтенда для ссылок в письмах (сброс пароля).
FRONTEND_URL=http://localhost:5173

# Почта. Если EMAIL_HOST_USER пуст — письма с кодами печатаются в консоль runserver.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MogGram <your-address@gmail.com>

# True на продакшене с HTTPS
COOKIE_SECURE=False
